# Every variable the service reads. Real values live in .env (ignored by git) or,
# inside an ai-space workspace, in <workspace>/data/photo-play/space.env which
# ai-space generates from space.yaml. Never put real values in this file.

# Set by ai-space from space.yaml (service.port). Bind 127.0.0.1 only.
PORT=8975

# Public URL of the app, used for the links the widget returns.
PUBLIC_BASE=

# Provided by ai-space; every picture is made through its model service.
# SPACE_API_URL=http://127.0.0.1:8700
# SPACE_APP_TOKEN=
# DATABASE_URL=sqlite:///path/to/main.db
# BLOB_URL=file:///path/to/blobs

# Wall-clock cap of one generation, seconds (default 600).
# PHOTO_JOB_TIMEOUT=600
# Largest upload in bytes (default 5 MB, the model service's per-image limit).
# PHOTO_MAX_UPLOAD=5242880
